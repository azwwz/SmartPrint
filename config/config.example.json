{
  "printer": {
    "name": "HP LaserJet 1020",
    "virtual_printer_name": "PDF24",
    "sumatra_path": "",
    "print_settings": "simplex",
    "timeout_seconds": 60.0,
    "queue_recheck_seconds": 0.0
  },
  "paper": {
    "size": "A4",
    "sheets_per_batch": 5
  },
  "duplex": {
    "mode": "manual",
    "front_page_order": "odd_first",
    "back_page_order": "even_descending",
